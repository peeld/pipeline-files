{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peeld.github.io/pipeline-files/schema/layout.schema.json",
  "title": "Entity layout configuration",
  "description": "The merged configuration: every section from every file in a config directory. The shape is checked here; cross-references (rule keys, parents, roots, template placeholders) are checked by the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "description": "Config version, recorded on every entity created under it.",
      "type": ["string", "integer"]
    },
    "keys": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/key" }
    },
    "rules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "roots": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/root" }
    },
    "links": {
      "description": "Per rule: the authority, the active and passive links, and their policies. A rule without links uses its parent's.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/rule_links" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "int", "date"], "default": "string" },
        "choices": { "type": "array", "minItems": 1, "description": "Allowed values, of the key's type." },
        "pattern": {
          "type": "string",
          "description": "Regular expression the value's text must fully match. Keep to syntax shared by common regex engines."
        },
        "format": {
          "type": "string",
          "pattern": "^[^{}]*\\{value\\}[^{}]*$",
          "default": "{value}",
          "description": "How the value is written into a name, for example \"v{value}\"."
        },
        "pad": { "type": "integer", "minimum": 0, "description": "Zero-pad int values to this many digits." },
        "date_format": {
          "type": "string",
          "default": "%Y-%m-%d",
          "description": "Date layout using %Y, %m and %d, each exactly once."
        },
        "default": { "description": "Static value used when none is given. Not applied inside optional groups." },
        "required": { "type": "boolean", "default": true, "description": "false lets a rule omit the key, in an optional group." }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "parent": { "type": "string" },
        "root": { "type": "string" },
        "keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true,
          "description": "Keys this rule adds to its parent's, in order."
        },
        "templates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9+.-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Template per backend. With a parent, continues the parent's template after a '/'."
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "enum": ["string", "int", "float", "bool", "date", "datetime", "list", "map"] }
        }
      }
    },
    "rule_links": {
      "type": "object",
      "minProperties": 1,
      "description": "Link name to settings. Exactly one link is the authority, which the loader checks.",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/link" }
    },
    "clash": {
      "enum": ["fail", "version_up", "suffix"],
      "default": "fail",
      "description": "What to do when a key or a file is already taken."
    },
    "link": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "const": "authority" },
            "offline": {
              "enum": ["fail", "read_only", "hold"],
              "default": "fail",
              "description": "What writes do when the authority is unreachable."
            },
            "clash": { "$ref": "#/$defs/clash" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "const": "active" },
            "order": { "type": "integer", "description": "Position among the active links. Required when there are several." },
            "rollback": { "type": "boolean", "default": true, "description": "Undo the whole write if this link fails." },
            "clash": { "$ref": "#/$defs/clash" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": { "const": "passive" },
            "triggers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" },
              "description": "Events that run the link. Empty means only an explicit call runs it."
            },
            "clash": { "$ref": "#/$defs/clash" }
          }
        }
      ]
    },
    "root": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "default": { "type": "string", "minLength": 1 },
            "platforms": {
              "type": "object",
              "propertyNames": { "enum": ["linux", "windows", "darwin"] },
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "hosts": {
              "type": "object",
              "description": "Hostname glob patterns, checked in order before platforms.",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
